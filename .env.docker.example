APP_NAME="Pump Monitoring"
APP_DESCRIPTION="Pemantauan gateway dan pompa produksi"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_PORT=8080
APP_BIND_IP=127.0.0.1
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=pump_monitoring
DB_USERNAME=hydroflow
DB_PASSWORD=CHANGE_THIS_DATABASE_PASSWORD
POSTGRES_DB=pump_monitoring
POSTGRES_USER=hydroflow
POSTGRES_PASSWORD=CHANGE_THIS_DATABASE_PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=sync
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CLIENT=phpredis
MQTT_LIVE_CACHE_STORE=redis
MQTT_HISTORY_INTERVAL_SECONDS=60

MQTT_HOST=CHANGE_THIS_EXTERNAL_BROKER_HOST
MQTT_PORT=8883
MQTT_CLIENT_ID_PREFIX=pump-monitoring
MQTT_USERNAME=CHANGE_THIS_MQTT_USERNAME
MQTT_PASSWORD=CHANGE_THIS_MQTT_PASSWORD
MQTT_CLEAN_SESSION=true
MQTT_CONNECT_TIMEOUT=5
MQTT_SOCKET_TIMEOUT=5
MQTT_KEEP_ALIVE=60
MQTT_TELEMETRY_TOPIC=devices/+/telemetry
MQTT_TELEMETRY_CLIENT_ID=pump-telemetry-ingest
MQTT_TLS_ENABLED=true
MQTT_TLS_VERIFY_PEER=true
MQTT_TLS_VERIFY_PEER_NAME=true
MQTT_TLS_ALLOW_SELF_SIGNED=false
MQTT_TLS_CA_FILE=
MQTT_TLS_CLIENT_CERTIFICATE_FILE=
MQTT_TLS_CLIENT_CERTIFICATE_KEY_FILE=
MQTT_TLS_CLIENT_CERTIFICATE_KEY_PASSPHRASE=
MQTT_LAST_WILL_TOPIC=dashboard/status
MQTT_LAST_WILL_MESSAGE=offline
MQTT_LAST_WILL_QOS=1
MQTT_LAST_WILL_RETAIN=false
# Isi hanya jika menjalankan profile Docker `tunnel`.
CLOUDFLARE_TUNNEL_TOKEN=

MAIL_MAILER=log
BROADCAST_CONNECTION=reverb

# Reverb internal endpoint used by Laravel and the Reverb container.
REVERB_APP_ID=hydroflow-production
REVERB_APP_KEY=CHANGE_THIS_REVERB_PUBLIC_KEY
REVERB_APP_SECRET=CHANGE_THIS_REVERB_SECRET
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Comma-separated hostnames only (without scheme or port).
REVERB_ALLOWED_ORIGINS=localhost

# Public browser endpoint, read at runtime so the image is reusable per client.
REVERB_PUBLIC_HOST=localhost
REVERB_PUBLIC_PORT=8080
REVERB_PUBLIC_SCHEME=http

FILESYSTEM_DISK=local
