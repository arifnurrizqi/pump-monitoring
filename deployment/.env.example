# Image distribution. Use a registry path without a trailing slash.
HYDROFLOW_DISTRIBUTION=registry
HYDROFLOW_PULL_POLICY=missing
HYDROFLOW_REGISTRY=ghcr.io/arifnurrizqi
HYDROFLOW_VERSION=1.0.0

APP_NAME="Pump Monitoring"
APP_DESCRIPTION="Pemantauan gateway dan pompa produksi"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://hydroflow.example.com
APP_VERSION=1.0.0
CUSTOMER_ID=CLIENT-001
INSTALLATION_ID=CLIENT-001-SERVER-01
APP_PORT=8080
APP_BIND_IP=127.0.0.1
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=pump_monitoring
DB_USERNAME=hydroflow
DB_PASSWORD=CHANGE_THIS_DATABASE_PASSWORD
POSTGRES_DB=pump_monitoring
POSTGRES_USER=hydroflow
POSTGRES_PASSWORD=CHANGE_THIS_DATABASE_PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync

MQTT_HOST=mqtt
MQTT_PORT=1883
MQTT_CLIENT_ID_PREFIX=pump-monitoring
MQTT_USERNAME=hydroflow
MQTT_PASSWORD=CHANGE_THIS_MQTT_PASSWORD
MQTT_CLEAN_SESSION=true
MQTT_CONNECT_TIMEOUT=5
MQTT_SOCKET_TIMEOUT=5
MQTT_KEEP_ALIVE=60
MQTT_TLS_ENABLED=false
MQTT_TLS_VERIFY_PEER=true
MQTT_TLS_VERIFY_PEER_NAME=true
MQTT_TLS_ALLOW_SELF_SIGNED=false
MQTT_TLS_CA_FILE=
MQTT_TLS_CLIENT_CERTIFICATE_FILE=
MQTT_TLS_CLIENT_CERTIFICATE_KEY_FILE=
MQTT_TLS_CLIENT_CERTIFICATE_KEY_PASSPHRASE=
MQTT_LAST_WILL_TOPIC=dashboard/status
MQTT_LAST_WILL_MESSAGE=offline
MQTT_LAST_WILL_QOS=1
MQTT_LAST_WILL_RETAIN=false
MQTT_BROKER_USERNAME=hydroflow
MQTT_BROKER_PASSWORD=CHANGE_THIS_MQTT_PASSWORD
MQTT_EXTERNAL_PORT=1883
MQTT_WEBSOCKET_PORT=9001
MQTT_BIND_IP=0.0.0.0

MAIL_MAILER=log
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=hydroflow-production
REVERB_APP_KEY=CHANGE_THIS_REVERB_PUBLIC_KEY
REVERB_APP_SECRET=CHANGE_THIS_REVERB_SECRET
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=hydroflow.example.com
REVERB_PUBLIC_HOST=hydroflow.example.com
REVERB_PUBLIC_PORT=443
REVERB_PUBLIC_SCHEME=https

# Optional Docker Cloudflare Tunnel profile. Point its public hostname to http://nginx:80.
CLOUDFLARE_TUNNEL_TOKEN=

FILESYSTEM_DISK=local
