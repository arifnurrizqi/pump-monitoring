APP_NAME="HYDROFLOW SYSTEM MONITORING"
APP_DESCRIPTION="A IoT Water Analyzer System by ARNUR TECH"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://water-analyzer-dashboard.test
APP_PORT=8080
APP_BIND_IP=127.0.0.1
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=water_analyzer
DB_USERNAME=hydroflow
DB_PASSWORD=CHANGE_THIS_DATABASE_PASSWORD
MYSQL_DATABASE=water_analyzer
MYSQL_USER=hydroflow
MYSQL_PASSWORD=CHANGE_THIS_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_THIS_ROOT_PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CLIENT=phpredis
MQTT_LIVE_CACHE_STORE=redis
MQTT_HISTORY_INTERVAL_SECONDS=60

MQTT_HOST=mqtt
MQTT_PORT=1883
MQTT_CLIENT_ID_PREFIX=hydroflow-dashboard
MQTT_USERNAME=hydroflow
MQTT_PASSWORD=CHANGE_THIS_MQTT_PASSWORD
MQTT_CLEAN_SESSION=true
MQTT_CONNECT_TIMEOUT=5
MQTT_SOCKET_TIMEOUT=5
MQTT_KEEP_ALIVE=60
MQTT_TELEMETRY_TOPIC=devices/+/telemetry
MQTT_TELEMETRY_CLIENT_ID=hydroflow-telemetry-ingest
MQTT_VALVE_ACK_TIMEOUT=15
MQTT_VALVE_QUEUE_TIMEOUT=30
MQTT_TLS_ENABLED=false
MQTT_TLS_VERIFY_PEER=true
MQTT_TLS_VERIFY_PEER_NAME=true
MQTT_TLS_ALLOW_SELF_SIGNED=false
MQTT_TLS_CA_FILE=
MQTT_TLS_CLIENT_CERTIFICATE_FILE=
MQTT_TLS_CLIENT_CERTIFICATE_KEY_FILE=
MQTT_TLS_CLIENT_CERTIFICATE_KEY_PASSPHRASE=
MQTT_LAST_WILL_TOPIC=dashboard/status
MQTT_LAST_WILL_MESSAGE=offline
MQTT_LAST_WILL_QOS=1
MQTT_LAST_WILL_RETAIN=false
MQTT_BROKER_USERNAME=hydroflow
MQTT_BROKER_PASSWORD=CHANGE_THIS_MQTT_PASSWORD
MQTT_EXTERNAL_PORT=1883
MQTT_WEBSOCKET_PORT=9001
MQTT_BIND_IP=0.0.0.0

# Isi hanya jika menjalankan profile Docker `tunnel`.
CLOUDFLARE_TUNNEL_TOKEN=

MAIL_MAILER=log
BROADCAST_CONNECTION=reverb

# Reverb internal endpoint used by Laravel queue and the Reverb container.
REVERB_APP_ID=hydroflow-production
REVERB_APP_KEY=CHANGE_THIS_REVERB_PUBLIC_KEY
REVERB_APP_SECRET=CHANGE_THIS_REVERB_SECRET
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Comma-separated hostnames only (without scheme or port).
REVERB_ALLOWED_ORIGINS=hydroflow.example.com

# Public browser endpoint, read at runtime so the image is reusable per client.
REVERB_PUBLIC_HOST=water-analyzer-dashboard.test
REVERB_PUBLIC_PORT=8081
REVERB_PUBLIC_SCHEME=http

FILESYSTEM_DISK=local
